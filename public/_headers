# Bộ nhớ đệm & bảo mật cho Cloudflare Pages

/*
  X-Content-Type-Options: nosniff
  # ==== GIAI ĐOẠN XEM THỬ ====
  # Chặn Google lập chỉ mục khi web còn thiếu nội dung.
  # XOÁ 2 DÒNG DƯỚI KHI RA MẮT CHÍNH THỨC.
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Ảnh album và ảnh hội viên tải lên qua /cap-nhat có tên file duy nhất, không
# bao giờ bị ghi đè, nên cache vĩnh viễn được.
/images/hoat-dong/*
  Cache-Control: public, max-age=31536000, immutable

/images/tai-len/*
  Cache-Control: public, max-age=31536000, immutable

# Ảnh chân dung do scripts/build-assets.mjs sinh ra thì GIỮ NGUYÊN TÊN mỗi lần
# chạy lại. Đánh dấu immutable ở đây là sai: người đã vào web sẽ ôm ảnh cũ cả
# năm dù CLB đã đổi ảnh. Cho cache một ngày, sau đó trình duyệt hỏi lại máy chủ.
/images/hoi-vien/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/images/*
  Cache-Control: public, max-age=604800

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=604800

# Trang quản trị không được lưu đệm và không cho nhúng iframe
/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
