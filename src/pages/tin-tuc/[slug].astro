---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { DANH_MUC_TIN } from '../../content.config';
import thuVien from '../../data/thu-vien.json';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const ds = await getCollection('tinTuc');
  return ds.map((b) => ({ params: { slug: b.id }, props: { b } }));
};

const { b } = Astro.props;
const d = b.data;
const { Content } = await render(b);

const tenDanhMuc = DANH_MUC_TIN[d.danhMuc as keyof typeof DANH_MUC_TIN];
const album = d.album ? thuVien.find((a) => a.slug === d.album) : undefined;

const khac = (await getCollection('tinTuc'))
  .filter((x) => x.id !== b.id)
  .sort((x, y) => y.data.ngay.valueOf() - x.data.ngay.valueOf())
  .slice(0, 3);

const ngayVn = (x: Date) =>
  x.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
---

<Base tieuDe={d.tieuDe} moTa={d.moTa} anh={d.anhBia || undefined}>
  <article>
    <section class="surface-deep relative isolate overflow-hidden">
      <img
        src="/logo-mark.svg"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute -right-16 top-10 w-[34rem] max-w-[75%] opacity-[0.07] brightness-0 invert"
      />
      <div class="container-page relative pb-16 pt-32 sm:pt-36 lg:pb-20 lg:pt-44">
        <nav aria-label="Đường dẫn" class="mb-8">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-medium text-brand-200">
            <li><a href="/" class="transition hover:text-white">Trang chủ</a></li>
            <li aria-hidden="true" class="text-brand-400">/</li>
            <li><a href="/tin-tuc" class="transition hover:text-white">Tin tức</a></li>
          </ol>
        </nav>

        <p class="text-xs font-bold uppercase tracking-[0.2em] text-accent-400">{tenDanhMuc}</p>
        <h1 class="mt-4 max-w-4xl text-(length:--text-h1) font-extrabold leading-[1.12] text-white">
          {d.tieuDe}
        </h1>
        <time datetime={d.ngay.toISOString()} class="mt-6 block text-sm font-semibold text-brand-200">
          {ngayVn(d.ngay)}
        </time>
      </div>
    </section>

    {
      d.anhBia && (
        <div class="container-page -mt-8 lg:-mt-12">
          <img
            src={d.anhBia}
            alt={d.tieuDe}
            width="1600"
            height="900"
            loading="eager"
            fetchpriority="high"
            class="aspect-16/9 w-full rounded-2xl object-cover shadow-2xl shadow-brand-900/25"
          />
        </div>
      )
    }

    <section class="py-14 lg:py-20">
      <div class="container-page">
        <div
          class="mx-auto max-w-3xl space-y-5 text-(length:--text-lead) leading-relaxed text-slate-600 [&_a]:font-semibold [&_a]:text-brand-600 [&_a]:underline [&_a]:underline-offset-4 [&_blockquote]:border-l-4 [&_blockquote]:border-accent-500 [&_blockquote]:pl-6 [&_blockquote]:italic [&_h2]:mt-12 [&_h2]:text-2xl [&_h2]:font-bold [&_h3]:mt-10 [&_h3]:text-xl [&_h3]:font-bold [&_img]:rounded-xl [&_li]:ml-5 [&_li]:list-disc [&_strong]:font-bold [&_strong]:text-brand-800"
        >
          <Content />
        </div>
      </div>
    </section>

    {
      album && (
        <section class="border-t border-slate-200 bg-slate-50 py-14 lg:py-20">
          <div class="container-page">
            <h2 class="rule-accent text-(length:--text-h2)">Hình ảnh chương trình</h2>
            <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
              {album.anh.slice(0, 8).map((a) => (
                <img
                  src={`/images/hoat-dong/${album.slug}/${a.ten}-thumb.webp`}
                  alt={album.ten}
                  width="640"
                  height="480"
                  loading="lazy"
                  decoding="async"
                  class="aspect-4/3 w-full rounded-xl object-cover ring-1 ring-slate-900/5"
                />
              ))}
            </div>
            <a
              href={`/thu-vien/${album.slug}`}
              class="mt-8 inline-flex rounded-full border-2 border-brand-600 px-6 py-3 text-sm font-bold text-brand-700 transition hover:bg-brand-600 hover:text-white"
            >
              Xem toàn bộ {album.soAnh} ảnh
            </a>
          </div>
        </section>
      )
    }

    {
      khac.length > 0 && (
        <section class="border-t border-slate-200 py-14 lg:py-20">
          <div class="container-page">
            <h2 class="rule-accent text-(length:--text-h2)">Bài viết khác</h2>
            <div class="mt-10 grid gap-6 sm:grid-cols-3">
              {khac.map((x) => (
                <a
                  href={`/tin-tuc/${x.id}`}
                  class="group rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-900/5 transition hover:-translate-y-1 hover:shadow-lg"
                >
                  <p class="text-[0.75rem] font-bold uppercase tracking-[0.14em] text-accent-500">
                    {DANH_MUC_TIN[x.data.danhMuc as keyof typeof DANH_MUC_TIN]}
                  </p>
                  <h3 class="mt-2.5 text-base font-bold leading-snug transition group-hover:text-brand-600">
                    {x.data.tieuDe}
                  </h3>
                  <time
                    datetime={x.data.ngay.toISOString()}
                    class="mt-4 block text-xs font-semibold text-slate-400"
                  >
                    {ngayVn(x.data.ngay)}
                  </time>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>
</Base>
