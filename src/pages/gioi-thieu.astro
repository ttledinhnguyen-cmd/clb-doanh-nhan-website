---
import Base from '../layouts/Base.astro';
import HeroTrang from '../components/HeroTrang.astro';
import TieuDeMuc from '../components/TieuDeMuc.astro';
import site from '../data/site.json';
import thuVien from '../data/thu-vien.json';

const anhMinhHoa = thuVien.find((a) => a.slug === 'caravan-tro-ve-tuoi-tho-toi-lan-10') ?? thuVien[0];
---

<Base
  tieuDe="Giới thiệu"
  moTa="Lịch sử hình thành, tiêu chí hoạt động và thành tựu của CLB Doanh nhân Khánh Hòa – Sài Gòn."
>
  <HeroTrang
    nhan="Về câu lạc bộ"
    tieuDe="Gắn kết những người con Khánh Hòa giữa lòng Sài Gòn"
    moTa="Từ một nhóm nhỏ anh chị em doanh nhân đồng hương, câu lạc bộ đã trở thành ngôi nhà chung của những người con Khánh Hòa đang lập nghiệp tại TP. Hồ Chí Minh."
    duongDan={[{ ten: 'Giới thiệu' }]}
  />

  {/* Lịch sử hình thành */}
  <section id="lich-su" class="scroll-mt-28 py-20 lg:py-28">
    <div class="container-page grid gap-14 lg:grid-cols-[1fr_0.85fr] lg:items-start lg:gap-20">
      <div>
        <TieuDeMuc nhan="Lịch sử hình thành" tieuDe="Câu lạc bộ ra đời như thế nào" />

        <div class="reveal mt-8 space-y-5 text-(length:--text-lead) leading-relaxed text-slate-600">
          <p>
            Tại TP. Hồ Chí Minh có phần đông những người con có gốc Khánh Hòa hoặc từng sống, làm
            việc tại Khánh Hòa, với mong muốn kết nối và tạo ra một tổ chức cùng nhau giao lưu, mang
            lại những giá trị tốt đẹp cho quê hương.
          </p>
          <p>
            Từ đây, <strong class="font-bold text-brand-800">Câu lạc bộ Doanh nhân Khánh Hòa – Sài Gòn</strong>
            ra đời vào ngày <strong class="font-bold text-brand-800">02/04/2016</strong> với sự bảo trợ
            từ {site.baoTro}, khởi đầu từ một số anh chị em doanh nhân có gốc Khánh Hòa.
          </p>
          <p>
            Sau đó câu lạc bộ hội tụ thành viên là các anh chị em doanh nhân, chuyên gia xuất thân từ
            Khánh Hòa hoặc có thời gian công tác, học tập, làm việc tại Khánh Hòa với tiêu chí
            <em class="font-semibold not-italic text-accent-600"
              >“Gắn kết đồng hương – Gia tăng giá trị – Nâng bước tương lai”</em
            >.
          </p>
        </div>
      </div>

      <div class="reveal lg:sticky lg:top-28">
        <img
          src={`/images/hoat-dong/${anhMinhHoa.slug}/${anhMinhHoa.anh[0].ten}.webp`}
          alt={anhMinhHoa.ten}
          width="1600"
          height="1067"
          loading="lazy"
          decoding="async"
          class="aspect-4/3 w-full rounded-2xl object-cover shadow-xl shadow-brand-900/15"
        />
        <dl class="mt-8 divide-y divide-slate-200 rounded-2xl bg-slate-50 px-6 ring-1 ring-slate-900/5">
          <div class="flex items-baseline justify-between gap-4 py-4">
            <dt class="text-sm text-slate-500">Ngày thành lập</dt>
            <dd class="text-sm font-bold text-brand-800">02/04/2016</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-4">
            <dt class="text-sm text-slate-500">Đơn vị bảo trợ</dt>
            <dd class="text-right text-sm font-bold text-brand-800">{site.baoTro}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-4">
            <dt class="text-sm text-slate-500">Địa bàn hoạt động</dt>
            <dd class="text-sm font-bold text-brand-800">TP. Hồ Chí Minh</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {/* Ba tiêu chí */}
  <section id="tieu-chi" class="scroll-mt-28 bg-brand-50/60 py-20 lg:py-28">
    <div class="container-page">
      <TieuDeMuc
        nhan="Tiêu chí hoạt động"
        tieuDe="Ba trụ cột của câu lạc bộ"
        moTa="Ba tiêu chí này vừa là kim chỉ nam, vừa là lời cam kết của câu lạc bộ với hội viên và với quê hương."
        giua
      />

      <div class="mt-14 space-y-6">
        {
          site.tieuChi.map((t, i) => (
            <article class="reveal grid gap-6 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-900/5 sm:grid-cols-[auto_1fr] sm:gap-10 sm:p-10">
              <div class="flex items-start gap-5 sm:flex-col sm:items-center">
                <span class="text-5xl font-extrabold leading-none text-brand-100 sm:text-6xl">
                  0{i + 1}
                </span>
                <img src="/logo-mark.svg" alt="" class="h-8 w-auto sm:mt-2" />
              </div>
              <div>
                <h3 class="text-2xl font-bold">{t.ten}</h3>
                <p class="mt-4 text-(length:--text-lead) leading-relaxed text-slate-600">
                  {t.noiDung}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Thành tựu */}
  <section id="thanh-tuu" class="scroll-mt-28 py-20 lg:py-28">
    <div class="container-page">
      <TieuDeMuc
        nhan="Thành tựu nổi bật"
        tieuDe="Những dấu mốc đã đi qua"
        moTa="Gần một thập kỷ hoạt động, câu lạc bộ để lại nhiều dấu ấn trong công tác thiện nguyện và xúc tiến thương mại."
      />

      <ol class="mt-14 space-y-0">
        {
          site.thanhTuu.map((t, i) => (
            <li class="reveal group relative grid gap-5 border-l-2 border-brand-100 pb-10 pl-8 last:pb-0 sm:grid-cols-[auto_1fr] sm:gap-8 sm:pl-10">
              <span
                aria-hidden="true"
                class="absolute -left-[9px] top-1 grid h-4 w-4 place-items-center rounded-full bg-white ring-2 ring-brand-300 transition-colors group-hover:ring-accent-500"
              >
                <span class="h-1.5 w-1.5 rounded-full bg-brand-500 transition-colors group-hover:bg-accent-500" />
              </span>
              <span class="text-sm font-extrabold uppercase tracking-[0.16em] text-brand-400 sm:pt-0.5">
                0{i + 1}
              </span>
              <p class="text-(length:--text-lead) leading-relaxed text-slate-700">{t}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Sự kiện thường niên nay có trang riêng */}
  <section class="bg-slate-50 py-20 lg:py-28">
    <div class="container-page">
      <TieuDeMuc
        nhan="Sinh hoạt CLB"
        tieuDe="Những chương trình thường niên"
        moTa="Caravan “Trở về tuổi thơ tôi”, chương trình nghệ thuật “Quê hương biển gọi”, họp định kỳ và tất niên câu lạc bộ."
        giua
      />
      <div class="reveal mt-10 text-center">
        <a
          href="/su-kien"
          class="inline-flex min-h-12 items-center rounded-full bg-brand-600 px-7 font-bold text-white shadow-lg shadow-brand-600/25 transition hover:-translate-y-0.5 hover:bg-brand-700"
          >Xem các sự kiện của câu lạc bộ</a
        >
      </div>
    </div>
  </section>
</Base>
