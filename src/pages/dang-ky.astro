---
import Base from '../layouts/Base.astro';
import HeroTrang from '../components/HeroTrang.astro';
import site from '../data/site.json';

/**
 * Đăng ký hội viên.
 *
 * Câu lạc bộ nhận hồ sơ bằng phiếu Google Biểu mẫu của ban thư ký. Phiếu có mục
 * tải ảnh chân dung, CCCD, giấy phép kinh doanh… nên Google bắt người điền đăng
 * nhập tài khoản Google, và phiếu loại này không nhúng vào trang được. Vì vậy
 * trang này nói rõ điều kiện, những gì cần chuẩn bị, rồi dẫn thẳng sang phiếu.
 *
 * Đường dẫn phiếu nằm ở `phieuDangKy` trong src/data/site.json; ban thư ký tự
 * đổi được ở mục "Thông tin chung của CLB" trong trang /cap-nhat.
 */
const phieu = site.phieuDangKy;
const { dienThoai, email } = site.lienHe;

/** Các mục trong phiếu, gom lại cho người đăng ký chuẩn bị trước. */
const canChuanBi = [
  {
    nhom: 'Thông tin cá nhân',
    muc: ['Họ và tên, ngày tháng năm sinh', 'Số điện thoại, email', 'Địa chỉ nhà'],
  },
  {
    nhom: 'Thông tin doanh nghiệp',
    muc: [
      'Chức vụ, đơn vị công tác',
      'Lĩnh vực kinh doanh, sản phẩm/dịch vụ chủ lực',
      'Đối tượng khách hàng',
      'Địa chỉ công ty, website doanh nghiệp',
    ],
  },
  {
    nhom: 'Ảnh và giấy tờ',
    muc: [
      'Ảnh chân dung',
      'Ảnh mặt trước căn cước công dân',
      'Logo doanh nghiệp',
      'Giấy phép kinh doanh (nếu là chủ doanh nghiệp)',
      'Giấy phép bổ nhiệm chức vụ (nếu có)',
    ],
  },
];

const dieuKien = [
  'Là người con Khánh Hòa, hoặc từng sinh sống, học tập, công tác tại Khánh Hòa.',
  'Đang là doanh nhân, chủ doanh nghiệp hoặc chuyên gia đang làm việc tại TP. Hồ Chí Minh và khu vực lân cận.',
  'Đồng thuận với tiêu chí “Gắn kết đồng hương – Gia tăng giá trị – Nâng bước tương lai”.',
  'Có hội viên hiện tại của câu lạc bộ giới thiệu (khuyến khích, không bắt buộc).',
];

const cacBuoc = [
  { ten: 'Điền phiếu đăng ký', moTa: 'Điền phiếu trên Google Biểu mẫu, kèm ảnh và giấy tờ đã chuẩn bị.' },
  { ten: 'Ban thư ký liên hệ', moTa: 'Ban thư ký xác nhận thông tin và trao đổi thêm trong vòng 5–7 ngày.' },
  { ten: 'Gặp mặt', moTa: 'Anh/chị được mời tham dự một buổi sinh hoạt định kỳ của câu lạc bộ.' },
  { ten: 'Kết nạp', moTa: 'Ban điều hành xét duyệt và làm lễ kết nạp hội viên mới.' },
];

const lopNutPhieu =
  'inline-flex min-h-13 w-full items-center justify-center gap-2.5 rounded-full bg-accent-500 px-8 text-base font-bold text-white shadow-xl shadow-accent-500/25 transition hover:-translate-y-0.5 hover:bg-accent-600 sm:w-auto';
---

<Base
  tieuDe="Đăng ký hội viên"
  moTa="Đăng ký trở thành hội viên CLB Doanh nhân Khánh Hòa – Sài Gòn: điều kiện, những gì cần chuẩn bị và phiếu đăng ký."
>
  <HeroTrang
    nhan="Hội viên"
    tieuDe="Đăng ký trở thành hội viên"
    moTa="Anh/chị điền phiếu đăng ký của câu lạc bộ. Ban thư ký nhận hồ sơ và liên hệ trong 5–7 ngày làm việc."
    duongDan={[{ ten: 'Hội viên', href: '/hoi-vien' }, { ten: 'Đăng ký hội viên' }]}
  >
    <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
      <a href={phieu} target="_blank" rel="noopener" class={lopNutPhieu}>
        Điền phiếu đăng ký
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
        </svg>
      </a>
      <p class="text-center text-sm text-brand-200 sm:text-left">Phiếu mở trên Google Biểu mẫu</p>
    </div>
  </HeroTrang>

  {/* Chuẩn bị trước khi điền */}
  <section class="py-14 lg:py-20">
    <div class="container-page">
      <h2 class="rule-accent text-(length:--text-h2)">Chuẩn bị trước khi điền</h2>
      <p class="mt-6 max-w-2xl text-[0.95rem] leading-relaxed text-slate-600">
        Phiếu gồm các mục dưới đây. Chuẩn bị sẵn thì điền một lần là xong.
      </p>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          canChuanBi.map((n, i) => (
            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-900/5 sm:p-7">
              <p class="flex items-center gap-3">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-brand-600 text-sm font-extrabold text-white">
                  {i + 1}
                </span>
                <span class="font-bold text-brand-900">{n.nhom}</span>
              </p>
              <ul class="mt-5 space-y-3">
                {n.muc.map((m) => (
                  <li class="flex items-start gap-3">
                    <svg
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      class="mt-0.5 h-5 w-5 shrink-0 text-accent-500"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 6L9 17l-5-5" />
                    </svg>
                    <span class="text-[0.95rem] leading-relaxed text-slate-600">{m}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="mt-8 rounded-2xl border-l-4 border-accent-500 bg-accent-50 p-5 sm:p-6">
        <p class="text-[0.95rem] leading-relaxed text-slate-700">
          <strong class="text-accent-700">Lưu ý:</strong> phiếu có phần tải ảnh và giấy tờ nên Google
          yêu cầu đăng nhập tài khoản Google (Gmail) trước khi điền. Ảnh chân dung, căn cước và logo
          mỗi tệp tối đa 10 MB; giấy phép kinh doanh và giấy phép bổ nhiệm tối đa 100 MB.
        </p>
      </div>
    </div>
  </section>

  {/* Điều kiện & quy trình */}
  <section class="border-t border-slate-200 bg-slate-50 py-14 lg:py-20">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="rule-accent text-(length:--text-h2)">Điều kiện tham gia</h2>
        <ul class="mt-8 space-y-4">
          {
            dieuKien.map((d) => (
              <li class="flex items-start gap-3.5">
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  class="mt-0.5 h-5 w-5 shrink-0 text-accent-500"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 6L9 17l-5-5" />
                </svg>
                <span class="text-[0.95rem] leading-relaxed text-slate-600">{d}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="rule-accent text-(length:--text-h2)">Quy trình kết nạp</h2>
        <ol class="mt-8 space-y-5">
          {
            cacBuoc.map((b, i) => (
              <li class="flex items-start gap-4">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-brand-600 text-sm font-extrabold text-white">
                  {i + 1}
                </span>
                <span>
                  <span class="block font-bold text-brand-900">{b.ten}</span>
                  <span class="mt-1 block text-[0.92rem] leading-relaxed text-slate-600">{b.moTa}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {/* Lời mời cuối trang */}
  <section class="py-14 lg:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-(length:--text-h2)">Sẵn sàng gia nhập câu lạc bộ?</h2>
        <div class="mt-8">
          <a href={phieu} target="_blank" rel="noopener" class={lopNutPhieu}>
            Điền phiếu đăng ký
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
            </svg>
          </a>
        </div>
        {/* Câu liên hệ viết liền một dòng: xuống dòng giữa các thẻ sinh ra dấu cách thừa trước dấu chấm. */}
        {
          (dienThoai || email) && (
            <p class="mt-7 text-[0.95rem] leading-relaxed text-slate-600">
              Gặp khó khăn khi điền phiếu, anh/chị liên hệ ban thư ký{dienThoai && <> qua số <a href={`tel:${dienThoai.replace(/[^\d+]/g, '')}`} class="font-semibold text-brand-700 underline underline-offset-4">{dienThoai}</a></>}{dienThoai && email && ' hoặc'}{email && <> email <a href={`mailto:${email}`} class="font-semibold text-brand-700 underline underline-offset-4">{email}</a></>}.
            </p>
          )
        }
      </div>
    </div>
  </section>
</Base>
