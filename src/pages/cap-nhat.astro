</Base>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const bieuMau = $('bieu-mau') as HTMLFormElement;
  const oNhap = (ten: string) => bieuMau.elements.namedItem(ten) as HTMLInputElement;
  const oVanBan = (ten: string) => bieuMau.elements.namedItem(ten) as unknown as HTMLTextAreaElement;
  const oChon = (ten: string) => bieuMau.elements.namedItem(ten) as unknown as HTMLSelectElement;
  const thongBao = $('thong-bao');
  const thanhLuu = $('thanh-luu');
  const nutLuu = $('nut-luu') as HTMLButtonElement;
  const trangThai = $('trang-thai');

  type CheDo = 'hoi-vien' | 'tin-tuc' | 'trang' | 'thong-tin';
  let cheDo: CheDo = 'hoi-vien';
  /** Tài khoản quản trị hoặc ban thư ký: sửa được toàn bộ nội dung. */
  let bienTap = false;
  let slugHienTai = '';
  let baiMoi = false;
  let hoiVienMoi = false;
  let anhMoi: string | null = null;
  let anhBiaMoi: string | null = null;

  type MucDanhBa = { slug: string; ten: string; doanhNghiep: string; nganhNghe: string; anh: string };
  let danhBa: MucDanhBa[] = [];

  const TEN_TRANG: Record<string, string> = {
    'cong-tac-xa-hoi': 'Hoạt động công tác xã hội',
    'phat-trien-thanh-vien': 'Hoạt động phát triển thành viên',
    'van-hoa-the-thao': 'Hoạt động văn hoá – Thể thao',
    'su-kien': 'Sự kiện câu lạc bộ',
  };

  const TEN_MUC: Record<string, string> = {
    'cong-tac-xa-hoi': 'Công tác xã hội',
    'phat-trien-thanh-vien': 'Phát triển thành viên',
    'van-hoa-the-thao': 'Văn hoá – Thể thao',
    'su-kien': 'Sự kiện CLB',
  };

  /** Ngày hôm nay theo giờ máy người dùng (không phải giờ UTC). */
  const homNay = () => {
    const d = new Date();
    return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
  };

  const TRUONG_HO_SO = [
    'hoTen', 'xungHo', 'chucDanh', 'doanhNghiep', 'nganhNghe', 'namThanhLap', 'quyMo',
    'dienThoai', 'email', 'website', 'diaChi', 'facebook', 'zalo', 'uuDaiHoiVien', 'gioiThieu',
  ];

  // ── Tiện ích ─────────────────────────────────────────────────────────────
  const dungLoi = (msg: string) => {
    $('dang-tai').hidden = true;
    $('khong-vao-duoc').hidden = false;
    $('ly-do').textContent = msg;
  };

  const bao = (msg: string, ok: boolean) => {
    thongBao.className =
      'rounded-xl px-5 py-4 text-[0.95rem] font-semibold ' +
      (ok
        ? 'bg-emerald-50 text-emerald-800 ring-1 ring-inset ring-emerald-200'
        : 'bg-red-50 text-red-800 ring-1 ring-inset ring-red-200');
    thongBao.textContent = msg;
    thongBao.hidden = false;
    thongBao.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  const goi = async (url: string, method: string, body: object) => {
    const res = await fetch(url, {
      method,
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });
    const kq = { ok: res.ok, ...(await res.json().catch(() => ({}))) } as any;
    // Phiên hết hạn giữa chừng thì không tự chuyển trang, kẻo mất phần đang sửa.
    if (res.status === 401) {
      kq.loi =
        'Phiên đăng nhập đã hết hạn. Anh/chị mở trang Đăng nhập ở một tab mới, đăng nhập xong quay lại đây bấm Lưu (phần đang sửa vẫn còn nguyên).';
    }
    return kq;
  };

  const docDataUrl = (blob: Blob) =>
    new Promise<string>((res, rej) => {
      const fr = new FileReader();
      fr.onload = () => res(String(fr.result));
      fr.onerror = () => rej(new Error('Không đọc được ảnh.'));
      fr.readAsDataURL(blob);
    });

  /**
   * Thu ảnh về cạnh dài `canhDai` px rồi nén lại ngay trên máy người dùng.
   *
   * Ưu tiên WebP. Safari (iPhone, Mac) không nén được WebP: xin WebP thì nó lặng
   * lẽ trả PNG nặng gấp nhiều lần và máy chủ từ chối, nên thấy kết quả không
   * phải WebP là chuyển sang JPEG.
   */
  async function veLai(anh: ImageBitmap, canhDai: number, chatLuong: number): Promise<string> {
    const ti = Math.min(1, canhDai / Math.max(anh.width, anh.height));
    const w = Math.round(anh.width * ti);
    const h = Math.round(anh.height * ti);
    const canvas = document.createElement('canvas');
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d')!;
    // Lót nền trắng: ảnh PNG trong suốt mà nén JPEG thì phần trong suốt thành đen.
    ctx.fillStyle = '#fff';
    ctx.fillRect(0, 0, w, h);
    ctx.drawImage(anh, 0, 0, w, h);
    const lay = (kieu: string) => new Promise<Blob | null>((r) => canvas.toBlob(r, kieu, chatLuong));
    let blob = await lay('image/webp');
    if (!blob || blob.type !== 'image/webp') blob = await lay('image/jpeg');
    if (!blob) throw new Error('Không xử lý được ảnh này.');
    return docDataUrl(blob);
  }

  /** Ảnh điện thoại 3–8 MB, thu về cạnh dài 1200px, còn khoảng 150–300 KB. */
  async function nenAnh(file: File): Promise<string> {
    const anh = await createImageBitmap(file);
    try {
      return await veLai(anh, 1200, 0.82);
    } finally {
      anh.close();
    }
  }

  const ganChonAnh = (
    idInput: string,
    idXemTruoc: string,
    idThongTin: string,
    lopAnh: string,
    dat: (s: string | null) => void,
  ) => {
    const inp = $(idInput) as HTMLInputElement;
    inp.addEventListener('change', async () => {
      const file = inp.files?.[0];
      if (!file) return;
      $(idThongTin).textContent = 'Đang xử lý ảnh…';
      try {
        const s = await nenAnh(file);
        dat(s);
        const img = $(idXemTruoc) as HTMLImageElement;
        img.src = s;
        img.className = lopAnh;
        $(idThongTin).textContent = `Đã chọn ảnh mới (${Math.round((s.length * 0.75) / 1024)} KB). Bấm Lưu để áp dụng.`;
      } catch (e) {
        dat(null);
        $(idThongTin).textContent = 'Không dùng được ảnh này, thử ảnh khác giúp tôi.';
        console.error(e);
      }
    });
  };

  ganChonAnh('chon-anh', 'xem-truoc', 'thong-tin-anh', 'aspect-3/4 w-full object-cover', (s) => (anhMoi = s));
  ganChonAnh('chon-anh-bia', 'xem-truoc-bia', 'thong-tin-anh-bia', 'aspect-4/3 w-full object-cover', (s) => (anhBiaMoi = s));

  // ── Bộ ảnh: ảnh sản phẩm của hội viên, ảnh hoạt động trong bài viết ───────
  /**
   * Mỗi ảnh trong bộ: `anh` là đường dẫn trên web — ảnh đã lưu, hoặc ảnh vừa
   * tải lên mà chưa lưu thành công. Ảnh vừa chọn giữ `lon`, `nho` (dữ liệu đã
   * nén) cho tới lúc tải lên; tải lên rồi thì giữ mã blob để lần lưu sau gửi
   * lại, phòng khi lần lưu trước hỏng giữa chừng mà ảnh chưa vào website.
   */
  type AnhTrongBo = {
    anh: string;
    xem: string;
    chuThich: string;
    lon?: string;
    nho?: string;
    blobLon?: string;
    blobNho?: string;
  };
  type LoaiBo = 'san-pham' | 'bai-viet';
  const CAU_HINH_BO = {
    'san-pham': { khung: 'bo-anh-san-pham', chon: 'chon-anh-san-pham', thongTin: 'thong-tin-anh-san-pham', toiDa: 12, coChuThich: true },
    'bai-viet': { khung: 'bo-anh-bai-viet', chon: 'chon-anh-bai-viet', thongTin: 'thong-tin-anh-bai-viet', toiDa: 30, coChuThich: false },
  } as const;
  const boAnh: Record<LoaiBo, AnhTrongBo[]> = { 'san-pham': [], 'bai-viet': [] };

  /** Ảnh đã lưu xem bằng bản nhỏ cho nhẹ; ảnh cũ không có bản nhỏ thì lấy ảnh lớn. */
  const banNho = (url: string) => url.replace(/\.(webp|jpg)$/, '-nho.$1');

  function veBo(loai: LoaiBo) {
    const ch = CAU_HINH_BO[loai];
    const khung = $(ch.khung);
    khung.innerHTML = '';
    boAnh[loai].forEach((x, i) => {
      const oAnh = document.createElement('div');
      oAnh.className = 'relative overflow-hidden rounded-xl bg-white ring-1 ring-slate-900/10';

      const img = document.createElement('img');
      img.className = 'aspect-4/3 w-full bg-slate-100 object-cover';
      img.alt = '';
      if (x.anh && x.xem !== x.anh) {
        img.onerror = () => {
          img.onerror = null;
          img.src = x.anh;
        };
      }
      img.src = x.xem;
      oAnh.appendChild(img);

      if (!x.anh || x.blobLon) {
        const moi = document.createElement('span');
        moi.className = 'absolute left-1.5 top-1.5 rounded-md bg-accent-500 px-1.5 py-0.5 text-[0.75rem] font-bold text-white';
        moi.textContent = 'Mới';
        oAnh.appendChild(moi);
      }

      const xoa = document.createElement('button');
      xoa.type = 'button';
      xoa.className = 'absolute right-1.5 top-1.5 grid h-10 w-10 place-items-center rounded-full bg-white/95 text-red-600 shadow-md ring-1 ring-slate-900/10 transition hover:bg-red-50';
      xoa.setAttribute('aria-label', `Bỏ ảnh ${i + 1}`);
      xoa.innerHTML =
        '<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>';
      xoa.addEventListener('click', () => {
        boAnh[loai].splice(i, 1);
        veBo(loai);
      });
      oAnh.appendChild(xoa);

      if (ch.coChuThich) {
        const inp = document.createElement('input');
        inp.type = 'text';
        inp.maxLength = 120;
        inp.placeholder = 'Chú thích (không bắt buộc)';
        inp.value = x.chuThich;
        inp.className =
          'block w-full border-0 border-t border-slate-100 bg-white px-3 py-2.5 text-base text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-brand-500 sm:text-[0.9rem]';
        inp.addEventListener('input', () => (x.chuThich = inp.value));
        oAnh.appendChild(inp);
      }
      khung.appendChild(oAnh);
    });
    $(ch.thongTin).textContent = boAnh[loai].length ? `${boAnh[loai].length} / ${ch.toiDa} ảnh` : '';
  }

  function napBo(loai: LoaiBo, ds: unknown, chuThich: unknown = []) {
    const dsUrl = Array.isArray(ds) ? ds.map(String) : [];
    const dsChu = Array.isArray(chuThich) ? chuThich.map(String) : [];
    boAnh[loai] = dsUrl.map((anh, i) => ({ anh, xem: banNho(anh), chuThich: dsChu[i] ?? '' }));
    veBo(loai);
  }

  for (const loai of Object.keys(CAU_HINH_BO) as LoaiBo[]) {
    const ch = CAU_HINH_BO[loai];
    const inp = $(ch.chon) as HTMLInputElement;
    inp.addEventListener('change', async () => {
      const tep = [...(inp.files ?? [])];
      inp.value = '';
      if (!tep.length) return;
      const conCho = ch.toiDa - boAnh[loai].length;
      if (conCho <= 0) {
        $(ch.thongTin).textContent = `Đã đủ ${ch.toiDa} ảnh. Bỏ bớt ảnh cũ rồi mới thêm được.`;
        return;
      }
      const lay = tep.slice(0, conCho);
      let hong = 0;
      for (const [k, f] of lay.entries()) {
        $(ch.thongTin).textContent = `Đang xử lý ảnh ${k + 1} / ${lay.length}…`;
        try {
          const bitmap = await createImageBitmap(f);
          try {
            const lon = await veLai(bitmap, 1600, 0.82);
            const nho = await veLai(bitmap, 600, 0.76);
            boAnh[loai].push({ anh: '', xem: nho, chuThich: '', lon, nho });
          } finally {
            bitmap.close();
          }
        } catch (e) {
          hong++;
          console.error(e);
        }
      }
      veBo(loai);
      const ghiChu = [
        tep.length > lay.length ? `chỉ lấy ${lay.length} ảnh vì tối đa ${ch.toiDa} ảnh` : '',
        hong ? `${hong} ảnh không đọc được, thử ảnh khác giúp tôi` : '',
      ]
        .filter(Boolean)
        .join('; ');
      $(ch.thongTin).textContent =
        `${boAnh[loai].length} / ${ch.toiDa} ảnh. Bấm Lưu để đăng ảnh mới lên web.` + (ghiChu ? ` (${ghiChu})` : '');
    });
  }

  /**
   * Tải ảnh mới trong bộ lên máy chủ, mỗi ảnh một lượt, rồi trả dữ liệu gửi kèm
   * lúc lưu: danh sách ảnh giữ lại đúng thứ tự, và mã blob của các ảnh mới.
   */
  async function chuanBiBo(loai: LoaiBo) {
    const ds = boAnh[loai];
    const canTai = ds.filter((x) => !x.anh);
    for (const [k, x] of canTai.entries()) {
      trangThai.textContent = `Đang tải ảnh ${k + 1} / ${canTai.length} lên…`;
      const kq = await goi('/api/anh', 'POST', { loai, lon: x.lon, nho: x.nho });
      if (!kq.ok) throw new Error(kq.loi ?? 'Tải ảnh lên không thành công.');
      Object.assign(x, { anh: kq.anh, blobLon: kq.blobLon, blobNho: kq.blobNho, lon: undefined, nho: undefined });
    }
    trangThai.textContent = 'Đang lưu…';
    return {
      danhSach: ds.map((x) => (CAU_HINH_BO[loai].coChuThich ? { anh: x.anh, chuThich: x.chuThich } : x.anh)),
      anhMoi: ds
        .filter((x) => x.blobLon)
        .map((x) => ({ anh: x.anh, blobLon: x.blobLon, blobNho: x.blobNho })),
    };
  }

  /** Lưu xong: ảnh mới thành ảnh đã lưu, bỏ mã blob và nhãn "Mới". */
  const chotBo = (loai: LoaiBo) => {
    for (const x of boAnh[loai]) {
      delete x.blobLon;
      delete x.blobNho;
    }
    veBo(loai);
  };

  // ── Danh sách động (sản phẩm, khách hàng) ────────────────────────────────
  const dongDanhSach = (khoi: HTMLElement, giaTri = '') => {
    const hang = document.createElement('div');
    hang.className = 'flex gap-2';
    hang.innerHTML =
      '<input type="text" class="w-full rounded-xl border-0 bg-white px-4 py-3 text-base text-slate-800 shadow-sm ring-1 ring-inset ring-slate-200 focus:ring-2 focus:ring-inset focus:ring-brand-500 sm:text-[0.95rem]">' +
      '<button type="button" class="grid h-12 w-12 shrink-0 place-items-center rounded-xl text-slate-400 transition hover:bg-red-50 hover:text-red-600" aria-label="Xoá dòng">' +
      '<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>';
    (hang.querySelector('input') as HTMLInputElement).value = giaTri;
    hang.querySelector('button')!.addEventListener('click', () => hang.remove());
    khoi.appendChild(hang);
    return hang;
  };

  for (const nut of document.querySelectorAll<HTMLButtonElement>('[data-them]')) {
    nut.addEventListener('click', () => {
      const khoi = $(nut.dataset.them === 'sanPham' ? 'ds-san-pham' : 'ds-khach-hang');
      (dongDanhSach(khoi).querySelector('input') as HTMLInputElement).focus();
    });
  }

  const docDanhSach = (id: string) =>
    [...document.querySelectorAll<HTMLInputElement>(`#${id} input`)].map((i) => i.value.trim()).filter(Boolean);

  // ── Bộ đếm ký tự ─────────────────────────────────────────────────────────
  const ganDem = (ten: string, idDem: string, max: number) => {
    const el = oVanBan(ten);
    const cap = () => {
      const n = el.value.length;
      $(idDem).textContent = `${n} / ${max} ký tự`;
      $(idDem).className = `mt-2 block text-right text-xs ${n > max ? 'font-bold text-red-600' : 'text-slate-400'}`;
    };
    el.addEventListener('input', cap);
    return cap;
  };
  const demGioiThieu = ganDem('gioiThieu', 'dem-gioi-thieu', 4000);
  const demTin = ganDem('tinNoiDung', 'dem-tin', 30000);
  const demTrang = ganDem('trangNoiDung', 'dem-trang', 20000);

  // ── Chuyển chế độ ────────────────────────────────────────────────────────
  const MOI_KHOI = [
    'khoi-chon-nguoi', 'than-hoi-vien',
    'khoi-chon-tin', 'than-tin-tuc',
    'khoi-chon-trang', 'than-trang',
    'than-thong-tin',
  ];

  const anHet = () => {
    for (const id of MOI_KHOI) $(id).hidden = true;
    thanhLuu.hidden = true;
    thongBao.hidden = true;
  };

  const daNap = { 'tin-tuc': false, trang: false };

  $('chon-che-do').addEventListener('change', async (e) => {
    cheDo = (e.target as HTMLSelectElement).value as CheDo;
    anHet();

    if (cheDo === 'hoi-vien') {
      $('khoi-chon-nguoi').hidden = false;
      if (oChonId('chon-nguoi').value) await moHoiVien();
    } else if (cheDo === 'tin-tuc') {
      $('khoi-chon-tin').hidden = false;
      if (!daNap['tin-tuc']) await napTinTuc();
    } else if (cheDo === 'trang') {
      $('khoi-chon-trang').hidden = false;
      if (!daNap.trang) await napTrang();
    } else {
      await moThongTin();
    }
  });

  const oChonId = (id: string) => $(id) as HTMLSelectElement;

  // ── Chế độ: hồ sơ hội viên ───────────────────────────────────────────────
  function donHoSo(h: Record<string, any>) {
    slugHienTai = String(h.slug ?? '');
    for (const t of [...TRUONG_HO_SO, 'chucVuClb', 'capBac', 'thuTu']) {
      const el = oNhap(t);
      if (el) el.value = h[t] == null ? '' : String(h[t]);
    }

    for (const [khoa, id] of [['sanPham', 'ds-san-pham'], ['khachHang', 'ds-khach-hang']] as const) {
      const khoi = $(id);
      khoi.innerHTML = '';
      const ds = Array.isArray(h[khoa]) ? (h[khoa] as string[]) : [];
      if (ds.length === 0) dongDanhSach(khoi);
      else for (const m of ds) dongDanhSach(khoi, m);
    }

    anhMoi = null;
    $('thong-tin-anh').textContent = '';
    napBo('san-pham', h.anhDoanhNghiep, h.chuThichAnh);
    const img = $('xem-truoc') as HTMLImageElement;
    const chuaCoAnh = () => {
      img.onerror = null;
      img.src = '/anh-chua-co-anh.svg';
      img.className = 'aspect-3/4 w-full object-cover';
    };

    // Ảnh do scripts/build-assets.mjs sinh ra mang mã băm nội dung trong tên
    // file, nên phải tra danh bạ chứ không ghép `${slug}.webp`: ghép tay sẽ trỏ
    // vào file cũ mà trình duyệt còn giữ trong bộ nhớ đệm cả năm.
    const nguonAnh = h.anh ? String(h.anh) : danhBa.find((m) => m.slug === slugHienTai)?.anh;
    if (nguonAnh) {
      img.className = 'aspect-3/4 w-full object-cover';
      img.onerror = chuaCoAnh;
      img.src = nguonAnh;
    } else chuaCoAnh();

    $('ghi-chu-hoi-vien-moi').hidden = !hoiVienMoi;
    $('khoi-xoa-hoi-vien').hidden = !bienTap || hoiVienMoi;

    // Hội viên thường chỉ được xem chức vụ; thư ký mới sửa được.
    if (bienTap) {
      $('khoi-chuc-vu').hidden = false;
      $('chuc-vu-xem').hidden = true;
    } else {
      $('khoi-chuc-vu').hidden = true;
      if (h.chucVuClb) {
        $('chuc-vu-xem').textContent = `Chức vụ trong CLB: ${h.chucVuClb}. Mục này do câu lạc bộ quản lý, cần đổi thì báo ban thư ký.`;
        $('chuc-vu-xem').hidden = false;
      } else $('chuc-vu-xem').hidden = true;
    }

    demGioiThieu();
    $('than-hoi-vien').hidden = false;
    thanhLuu.hidden = false;
  }

  async function moHoiVien() {
    const slug = oChonId('chon-nguoi').value;
    hoiVienMoi = false;
    if (!slug) {
      $('than-hoi-vien').hidden = true;
      thanhLuu.hidden = true;
      return;
    }
    thongBao.hidden = true;
    const kq = await goi('/api/ho-so', 'PUT', { slug, layHoSo: true });
    if (kq.ok) donHoSo(kq.hoSo);
    else bao(kq.loi ?? 'Không mở được hồ sơ này.', false);
  }

  $('chon-nguoi').addEventListener('change', moHoiVien);

  $('nut-hoi-vien-moi').addEventListener('click', () => {
    hoiVienMoi = true;
    thongBao.hidden = true;
    oChonId('chon-nguoi').value = '';
    donHoSo({ slug: '', thuTu: 9999, nganhNghe: '' });
    oNhap('hoTen').focus();
  });

  $('nut-xoa-hoi-vien').addEventListener('click', async () => {
    const ten = oNhap('hoTen').value.trim() || slugHienTai;
    if (!confirm(`Xoá hẳn hội viên "${ten}" khỏi website?`)) return;
    const kq = await goi('/api/ho-so', 'PUT', { slug: slugHienTai, xoa: true });
    if (!kq.ok) return bao(kq.loi ?? 'Xoá không thành công.', false);
    oChonId('chon-nguoi').querySelector(`option[value="${slugHienTai}"]`)?.remove();
    oChonId('chon-nguoi').value = '';
    slugHienTai = '';
    $('than-hoi-vien').hidden = true;
    thanhLuu.hidden = true;
    bao(`Đã xoá hội viên ${ten}. Website sẽ cập nhật sau khoảng 1–2 phút.`, true);
  });

  // ── Chế độ: bài viết theo mục hoạt động ──────────────────────────────────
  type BaiTomTat = { slug: string; tieuDe: string; ngay: string; danhMuc: string; anhBia: string; soAnh: number };
  let dsBai: BaiTomTat[] = [];
  let mucDangChon = 'cong-tac-xa-hoi';

  const ngayVn = (s: string) => {
    const m = String(s).match(/^(\d{4})-(\d{2})-(\d{2})/);
    return m ? `${m[3]}/${m[2]}/${m[1]}` : '';
  };

  function veDsBai() {
    const ul = $('ds-bai');
    ul.innerHTML = '';
    const trongMuc = dsBai.filter((b) => b.danhMuc === mucDangChon);
    if (!trongMuc.length) {
      const li = document.createElement('li');
      li.className = 'rounded-xl border border-dashed border-slate-300 bg-white px-4 py-5 text-center text-[0.9rem] text-slate-500';
      li.textContent = daNap['tin-tuc']
        ? `Mục ${TEN_MUC[mucDangChon]} chưa có bài nào. Bấm nút phía trên để viết bài đầu tiên.`
        : 'Đang tải danh sách bài…';
      ul.appendChild(li);
      return;
    }
    for (const b of trongMuc) {
      const li = document.createElement('li');
      const nut = document.createElement('button');
      nut.type = 'button';
      nut.className =
        'flex w-full items-center gap-3 rounded-xl bg-white p-2.5 text-left ring-1 ring-slate-900/5 transition hover:ring-brand-300 aria-[current=true]:ring-2 aria-[current=true]:ring-brand-500';
      nut.setAttribute('aria-current', String(!baiMoi && b.slug === slugHienTai));

      const anh = document.createElement('img');
      anh.alt = '';
      anh.className = b.anhBia
        ? 'h-14 w-18 shrink-0 rounded-lg bg-brand-50 object-cover'
        : 'h-14 w-18 shrink-0 rounded-lg bg-brand-50 object-contain p-2 opacity-40';
      anh.src = b.anhBia || '/logo-goc.svg';

      const chu = document.createElement('span');
      chu.className = 'min-w-0 flex-1';
      const td = document.createElement('span');
      td.className = 'line-clamp-2 block text-[0.95rem] font-semibold leading-snug text-brand-900';
      td.textContent = b.tieuDe;
      const phu = document.createElement('span');
      phu.className = 'mt-1 block text-[0.8rem] text-slate-500';
      phu.textContent = [ngayVn(b.ngay), b.soAnh ? `${b.soAnh} ảnh` : ''].filter(Boolean).join(' · ');
      chu.append(td, phu);

      nut.append(anh, chu);
      nut.addEventListener('click', () => moBai(b.slug));
      li.appendChild(nut);
      ul.appendChild(li);
    }
  }

  function chonMuc(muc: string) {
    mucDangChon = muc;
    for (const n of document.querySelectorAll<HTMLButtonElement>('#chon-muc [data-muc]')) {
      n.setAttribute('aria-pressed', String(n.dataset.muc === muc));
    }
    $('nhan-bai-moi').textContent = `Viết bài mới cho mục ${TEN_MUC[muc]}`;
    veDsBai();
  }

  for (const n of document.querySelectorAll<HTMLButtonElement>('#chon-muc [data-muc]')) {
    n.addEventListener('click', () => {
      $('than-tin-tuc').hidden = true;
      thanhLuu.hidden = true;
      thongBao.hidden = true;
      slugHienTai = '';
      chonMuc(n.dataset.muc!);
    });
  }

  async function napTinTuc() {
    // Lần đầu mở thì hiện chữ "Đang tải danh sách bài…" trong lúc chờ máy chủ.
    if (!daNap['tin-tuc']) veDsBai();
    const kq = await goi('/api/tin-tuc', 'POST', {});
    if (!kq.ok) return bao(kq.loi ?? 'Không lấy được danh sách bài viết.', false);
    dsBai = kq.danhSach;
    daNap['tin-tuc'] = true;
    veDsBai();
  }

  function donBai(b: Record<string, any>) {
    slugHienTai = String(b.slug ?? '');
    oNhap('tinTieuDe').value = b.tieuDe ?? '';
    oVanBan('tinMoTa').value = b.moTa ?? '';
    oNhap('tinNgay').value = String(b.ngay ?? '').slice(0, 10);
    oChon('tinDanhMuc').value = b.danhMuc ?? mucDangChon;
    oChon('tinAlbum').value = b.album ?? '';
    oVanBan('tinNoiDung').value = b.noiDung ?? '';

    anhBiaMoi = null;
    $('thong-tin-anh-bia').textContent = '';
    const img = $('xem-truoc-bia') as HTMLImageElement;
    if (b.anhBia) {
      img.src = String(b.anhBia);
      img.className = 'aspect-4/3 w-full object-cover';
    } else {
      img.src = '/logo-goc.svg';
      img.className = 'aspect-4/3 w-full bg-slate-100 object-contain p-8 opacity-30';
    }
    napBo('bai-viet', b.hinhAnh);

    demTin();
    $('khoi-xoa-tin').hidden = baiMoi;
    $('than-tin-tuc').hidden = false;
    thanhLuu.hidden = false;
    veDsBai();
  }

  async function moBai(slug: string) {
    thongBao.hidden = true;
    baiMoi = false;
    const kq = await goi('/api/tin-tuc', 'PUT', { slug });
    if (!kq.ok) return bao(kq.loi ?? 'Không mở được bài viết.', false);
    donBai(kq.bai);
    $('than-tin-tuc').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  $('nut-bai-moi').addEventListener('click', () => {
    baiMoi = true;
    thongBao.hidden = true;
    donBai({ ngay: homNay(), danhMuc: mucDangChon });
    oNhap('tinTieuDe').focus();
  });

  $('nut-xoa-tin').addEventListener('click', async () => {
    if (!confirm('Xoá hẳn bài viết này khỏi website?')) return;
    const kq = await goi('/api/tin-tuc', 'PUT', { slug: slugHienTai, xoa: true });
    if (!kq.ok) return bao(kq.loi ?? 'Xoá không thành công.', false);
    $('than-tin-tuc').hidden = true;
    thanhLuu.hidden = true;
    slugHienTai = '';
    await napTinTuc();
    bao('Đã xoá bài viết. Website sẽ cập nhật sau khoảng 1–2 phút.', true);
  });

  // ── Chế độ: nội dung trang ───────────────────────────────────────────────
  async function napTrang() {
    const kq = await goi('/api/trang', 'POST', {});
    if (!kq.ok) return bao(kq.loi ?? 'Không lấy được danh sách trang.', false);
    const sel = oChonId('chon-trang');
    for (const t of kq.danhSach as string[]) {
      const opt = document.createElement('option');
      opt.value = t;
      opt.textContent = TEN_TRANG[t] ?? t;
      sel.appendChild(opt);
    }
    daNap.trang = true;
  }

  $('chon-trang').addEventListener('change', async () => {
    const slug = oChonId('chon-trang').value;
    if (!slug) {
      $('than-trang').hidden = true;
      thanhLuu.hidden = true;
      return;
    }
    thongBao.hidden = true;
    const kq = await goi('/api/trang', 'PUT', { slug });
    if (!kq.ok) return bao(kq.loi ?? 'Không mở được trang này.', false);
    const t = kq.noiDung;
    slugHienTai = t.slug;
    oNhap('trangTieuDe').value = t.tieuDe ?? '';
    oNhap('trangNhan').value = t.nhan ?? '';
    oVanBan('trangMoTa').value = t.moTa ?? '';
    oVanBan('trangNoiDung').value = t.noiDung ?? '';
    demTrang();
    $('than-trang').hidden = false;
    thanhLuu.hidden = false;
  });

  // ── Chế độ: thông tin chung ──────────────────────────────────────────────
  async function moThongTin() {
    const kq = await goi('/api/thong-tin', 'POST', {});
    if (!kq.ok) return bao(kq.loi ?? 'Không lấy được thông tin câu lạc bộ.', false);
    const t = kq.thongTin;
    oNhap('ttKhauHieu').value = t.khauHieu ?? '';
    oVanBan('ttMoTa').value = t.moTa ?? '';
    oNhap('ttDiaChi').value = t['lienHe.diaChi'] ?? '';
    oNhap('ttDienThoai').value = t['lienHe.dienThoai'] ?? '';
    oNhap('ttEmail').value = t['lienHe.email'] ?? '';
    oNhap('ttFacebook').value = t['lienHe.facebook'] ?? '';
    oNhap('ttYoutube').value = t['lienHe.youtube'] ?? '';
    oNhap('ttZalo').value = t['lienHe.zalo'] ?? '';
    oNhap('ttPhieuDangKy').value = t.phieuDangKy ?? '';
    $('than-thong-tin').hidden = false;
    thanhLuu.hidden = false;
  }

  // ── Lưu ──────────────────────────────────────────────────────────────────
  const luuTheoCheDo = async () => {
    if (cheDo === 'hoi-vien') {
      const duLieu: Record<string, unknown> = {};
      for (const t of TRUONG_HO_SO) {
        const el = oNhap(t);
        if (el) duLieu[t] = el.value;
      }
      if (hoiVienMoi && !String(duLieu.hoTen ?? '').trim()) throw new Error('Hội viên mới phải có họ và tên.');
      if (bienTap) {
        for (const t of ['chucVuClb', 'capBac', 'thuTu']) duLieu[t] = oNhap(t).value;
      }
      duLieu.sanPham = docDanhSach('ds-san-pham');
      duLieu.khachHang = docDanhSach('ds-khach-hang');
      // Ảnh sản phẩm tải lên trước, từng ảnh một, rồi mới gửi hồ sơ.
      const bo = await chuanBiBo('san-pham');
      duLieu.anhDoanhNghiep = bo.danhSach;
      return goi('/api/ho-so', 'PUT', {
        slug: slugHienTai,
        moi: hoiVienMoi,
        duLieu,
        anhMoi: bo.anhMoi,
        ...(anhMoi ? { anh: anhMoi } : {}),
      });
    }

    if (cheDo === 'tin-tuc') {
      const duLieu: Record<string, unknown> = {
        tieuDe: oNhap('tinTieuDe').value,
        moTa: oVanBan('tinMoTa').value,
        ngay: oNhap('tinNgay').value,
        danhMuc: oChon('tinDanhMuc').value,
        album: oChon('tinAlbum').value,
        noiDung: oVanBan('tinNoiDung').value,
      };
      if (!String(duLieu.tieuDe).trim()) throw new Error('Bài viết phải có tiêu đề.');
      const bo = await chuanBiBo('bai-viet');
      duLieu.hinhAnh = bo.danhSach;
      return goi('/api/tin-tuc', 'PUT', {
        slug: slugHienTai,
        duLieu,
        moi: baiMoi,
        anhMoi: bo.anhMoi,
        ...(anhBiaMoi ? { anhBia: anhBiaMoi } : {}),
      });
    }

    if (cheDo === 'trang') {
      const duLieu = {
        tieuDe: oNhap('trangTieuDe').value,
        nhan: oNhap('trangNhan').value,
        moTa: oVanBan('trangMoTa').value,
        noiDung: oVanBan('trangNoiDung').value,
      };
      if (!duLieu.tieuDe.trim()) throw new Error('Tiêu đề trang không được để trống.');
      return goi('/api/trang', 'PUT', { slug: slugHienTai, duLieu });
    }

    return goi('/api/thong-tin', 'PUT', {
      duLieu: {
        khauHieu: oNhap('ttKhauHieu').value,
        moTa: oVanBan('ttMoTa').value,
        'lienHe.diaChi': oNhap('ttDiaChi').value,
        'lienHe.dienThoai': oNhap('ttDienThoai').value,
        'lienHe.email': oNhap('ttEmail').value,
        'lienHe.facebook': oNhap('ttFacebook').value,
        'lienHe.youtube': oNhap('ttYoutube').value,
        'lienHe.zalo': oNhap('ttZalo').value,
        phieuDangKy: oNhap('ttPhieuDangKy').value,
      },
    });
  };

  nutLuu.addEventListener('click', async () => {
    nutLuu.disabled = true;
    const chuCu = nutLuu.textContent;
    nutLuu.textContent = 'Đang lưu…';
    trangThai.textContent = 'Đang gửi lên máy chủ…';
    thongBao.hidden = true;

    try {
      const kq = await luuTheoCheDo();
      if (!kq.ok) throw new Error(kq.loi ?? 'Lưu không thành công.');

      if (kq.khongDoi) {
        bao('Không có gì thay đổi so với nội dung hiện tại.', true);
        trangThai.textContent = 'Không có thay đổi';
      } else {
        bao('Đã lưu xong. Website sẽ hiển thị nội dung mới sau khoảng 1–2 phút.', true);
        trangThai.textContent = 'Đã lưu';
        anhMoi = null;
        anhBiaMoi = null;
        $('thong-tin-anh').textContent = '';
        $('thong-tin-anh-bia').textContent = '';

        if (cheDo === 'hoi-vien') {
          chotBo('san-pham');
          if (hoiVienMoi && kq.slug) {
            // Hội viên mới đã có mã riêng: chuyển sang chế độ sửa để lần lưu sau
            // không tạo thêm một hồ sơ trùng.
            hoiVienMoi = false;
            slugHienTai = kq.slug;
            const sel = oChonId('chon-nguoi');
            const opt = document.createElement('option');
            const dn = oNhap('doanhNghiep').value.trim();
            opt.value = kq.slug;
            opt.textContent =
              [oNhap('xungHo').value, oNhap('hoTen').value.trim()].filter(Boolean).join(' ') + (dn ? ` — ${dn}` : '');
            sel.appendChild(opt);
            sel.value = kq.slug;
            $('ghi-chu-hoi-vien-moi').hidden = true;
            $('khoi-xoa-hoi-vien').hidden = false;
          }
        }

        if (cheDo === 'tin-tuc') {
          chotBo('bai-viet');
          if (baiMoi && kq.slug) {
            // Bài mới đã có mã riêng: chuyển sang chế độ sửa để lần lưu sau không
            // tạo thêm bài trùng.
            baiMoi = false;
            slugHienTai = kq.slug;
            $('khoi-xoa-tin').hidden = false;
          }
          // Bài vừa đổi sang mục khác thì chuyển theo, cho bài khỏi "biến mất".
          const muc = oChon('tinDanhMuc').value;
          if (muc !== mucDangChon) chonMuc(muc);
          await napTinTuc();
        }
      }
    } catch (e) {
      bao((e as Error).message, false);
      trangThai.textContent = 'Lưu chưa được';
    } finally {
      nutLuu.disabled = false;
      nutLuu.textContent = chuCu;
    }
  });

  // ── Mở phiên ─────────────────────────────────────────────────────────────
  async function moPhien() {
    // Đường dẫn riêng kiểu cũ (?ma=…) thôi dùng từ 15/09/2026: xoá mã khỏi thanh
    // địa chỉ rồi mời đăng nhập bằng tài khoản.
    if (new URLSearchParams(location.search).has('ma')) {
      history.replaceState(null, '', location.pathname);
      return dungLoi('Đường dẫn riêng đã ngừng sử dụng. Trang cập nhật giờ đăng nhập bằng tài khoản do ban thư ký cấp.');
    }

    try {
      const phien = await fetch('/api/phien');
      if (phien.status === 401) return location.replace('/dang-nhap?tiep=/cap-nhat');
      const tk = await phien.json().catch(() => ({}));
      if (!phien.ok) return dungLoi(tk.loi ?? 'Không mở được trang cập nhật.');
      $('ten-tai-khoan').textContent = `${tk.taiKhoan.tenHienThi} (${tk.taiKhoan.tenDangNhap})`;
      $('thanh-tai-khoan').hidden = false;

      danhBa = await fetch('/danh-ba.json').then((r) => (r.ok ? r.json() : [])).catch(() => []);

      const kq = await goi('/api/ho-so', 'POST', {});
      if (!kq.ok) return dungLoi(kq.loi ?? 'Không mở được hồ sơ.');

      bienTap = Boolean(kq.bienTap);
      $('dang-tai').hidden = true;
      bieuMau.hidden = false;

      // Gợi ý ngành nghề đã có, để tên ngành không bị mỗi người viết một kiểu.
      const dl = $('ds-nganh');
      for (const n of new Set(danhBa.map((m) => m.nganhNghe).filter(Boolean))) {
        if (n === 'Đang cập nhật') continue;
        const opt = document.createElement('option');
        opt.value = n;
        dl.appendChild(opt);
      }

      if (bienTap) {
        $('loi-chao').textContent =
          'Chế độ ban thư ký — thêm, sửa, xoá hội viên; đăng bài cho từng mục hoạt động; sửa phần giới thiệu các trang và thông tin chung của câu lạc bộ.';
        $('khoi-che-do').hidden = false;
        $('khoi-chon-nguoi').hidden = false;

        const sel = oChonId('chon-nguoi');
        for (const s of kq.danhSach as string[]) {
          const muc = danhBa.find((m) => m.slug === s);
          const opt = document.createElement('option');
          opt.value = s;
          opt.textContent = muc ? muc.ten + (muc.doanhNghiep ? ` — ${muc.doanhNghiep}` : '') : s;
          sel.appendChild(opt);
        }

        // Danh sách album để gắn vào bài viết
        const albums = await fetch('/thu-vien.json')
          .then((r) => (r.ok ? r.json() : []))
          .catch(() => []);
        const selAlbum = oChon('tinAlbum');
        for (const a of albums as any[]) {
          const opt = document.createElement('option');
          opt.value = a.slug;
          opt.textContent = a.ten;
          selAlbum.appendChild(opt);
        }
      } else {
        donHoSo(kq.hoSo);
        const ten = [kq.hoSo.xungHo, kq.hoSo.hoTen].filter(Boolean).join(' ');
        $('loi-chao').textContent = `Kính chào ${ten}. Anh/chị sửa thông tin bên dưới rồi bấm Lưu.`;
      }
    } catch {
      dungLoi('Không kết nối được tới máy chủ. Anh/chị kiểm tra mạng rồi thử lại.');
    }
  }

  $('nut-dang-xuat').addEventListener('click', async () => {
    await fetch('/api/dang-xuat', { method: 'POST' }).catch(() => {});
    location.replace('/dang-nhap');
  });

  moPhien();
</script>
