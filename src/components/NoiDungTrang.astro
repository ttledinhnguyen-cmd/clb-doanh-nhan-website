---
/**
 * Khung chung cho các trang nội dung do ban thư ký tự sửa
 * (Công tác xã hội, Phát triển thành viên, Văn hoá – Thể thao, Sự kiện CLB).
 *
 * Bấm vào một mục là thấy ngay các bài của mục đó, như trang chuyên mục của
 * một trang tin; phần giới thiệu và album ảnh nằm bên dưới. Mục chưa có bài
 * nào thì phần giới thiệu lên thẳng dưới đầu trang.
 */
import HeroTrang from './HeroTrang.astro';
import { render, getCollection, type CollectionEntry } from 'astro:content';
import { anhNho, anhAlbumNho, locAlbum } from '../lib/anh';
import thuVienGoc from '../data/thu-vien.json';

const thuVien = locAlbum(thuVienGoc);

interface Props {
  muc: CollectionEntry<'trang'>;
  duongDan: { ten: string; href?: string }[];
}
const { muc, duongDan } = Astro.props;
const d = muc.data;
const { Content } = await render(muc);

// Thân rỗng thì giấu hẳn khối giới thiệu, không để lại tiêu đề lơ lửng.
// Ban thư ký xoá sạch ô nội dung ở /cap-nhat cũng rơi vào trường hợp này.
const coNoiDung = Boolean(muc.body?.trim());

const album = d.danhMucAlbum ? thuVien.filter((a) => a.danhMuc === d.danhMucAlbum) : [];
const baiViet = d.danhMucTin
  ? (await getCollection('tinTuc'))
      .filter((b) => b.data.danhMuc === d.danhMucTin)
      .sort((a, b) => b.data.ngay.valueOf() - a.data.ngay.valueOf())
  : [];

/** Ảnh đại diện của bài: ảnh bìa, không có thì lấy ảnh đầu tiên trong bài. */
const anhDaiDien = (b: (typeof baiViet)[number]) =>
  b.data.anhBia || (b.data.hinhAnh[0] ? (anhNho(b.data.hinhAnh[0]) ?? b.data.hinhAnh[0]) : '');

const ngayVn = (x: Date) =>
  x.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
---

<HeroTrang nhan={d.nhan} tieuDe={d.tieuDe} moTa={d.moTa} duongDan={duongDan} />

{
  baiViet.length > 0 && (
    <section class="py-14 lg:py-20">
      <div class="container-page">
        <h2 class="rule-accent text-(length:--text-h2)">Hoạt động gần đây</h2>
        <div class="mt-10 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
          {baiViet.map((b, i) => (
            <a
              href={`/tin-tuc/${b.id}`}
              class="group flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-900/5 transition duration-500 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-brand-900/10"
            >
              {anhDaiDien(b) ? (
                <img
                  src={anhDaiDien(b)}
                  alt=""
                  width="640"
                  height="480"
                  loading={i < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="aspect-4/3 w-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              ) : (
                <div class="grid aspect-4/3 w-full place-items-center bg-brand-50">
                  <img src="/logo-goc.svg" alt="" width="261" height="258" class="h-24 w-auto opacity-30" />
                </div>
              )}
              <div class="flex flex-1 flex-col p-6">
                <time datetime={b.data.ngay.toISOString()} class="text-xs font-semibold text-slate-500">
                  {ngayVn(b.data.ngay)}
                </time>
                <h3 class="mt-2 text-lg font-bold leading-snug transition group-hover:text-brand-600">
                  {b.data.tieuDe}
                </h3>
                {b.data.moTa && (
                  <p class="mt-3 line-clamp-3 text-[0.92rem] leading-relaxed text-slate-600">{b.data.moTa}</p>
                )}
                {b.data.hinhAnh.length > 0 && (
                  <p class="mt-auto pt-4 text-[0.75rem] font-bold uppercase tracking-[0.14em] text-accent-600">
                    {b.data.hinhAnh.length} hình ảnh
                  </p>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  coNoiDung && (
    <section class:list={['py-12 lg:py-16', baiViet.length > 0 && 'border-t border-slate-200']}>
      <div class="container-page">
        {
          baiViet.length > 0 && (
            <h2 class="rule-accent mx-auto mb-8 max-w-3xl text-(length:--text-h2)">Giới thiệu</h2>
          )
        }
        <div
          class="mx-auto max-w-3xl space-y-5 text-(length:--text-lead) leading-relaxed text-slate-600 [&_a]:font-semibold [&_a]:text-brand-600 [&_a]:underline [&_a]:underline-offset-4 [&_h2]:mt-11 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-brand-900 [&_h3]:mt-9 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-brand-900 [&_li]:ml-5 [&_li]:list-disc [&_strong]:font-bold [&_strong]:text-brand-800"
        >
          <Content />
        </div>
      </div>
    </section>
  )
}

{
  album.length > 0 && (
    <section class="border-t border-slate-200 bg-slate-50 py-14 lg:py-20">
      <div class="container-page">
        <h2 class="rule-accent text-(length:--text-h2)">Hình ảnh</h2>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {album.map((a) => (
            <a
              href={`/thu-vien/${a.slug}`}
              class="group reveal relative overflow-hidden rounded-2xl shadow-sm ring-1 ring-slate-900/5 transition duration-500 hover:-translate-y-1.5 hover:shadow-xl"
            >
              <img
                src={anhAlbumNho(a.slug, a.anh[0])}
                alt={a.ten}
                width="640"
                height="480"
                loading="lazy"
                decoding="async"
                class="aspect-4/3 w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-950 via-brand-950/35 to-transparent" />
              <div class="absolute inset-x-0 bottom-0 p-5">
                <p class="text-[0.75rem] font-bold uppercase tracking-[0.14em] text-accent-400">
                  {a.soAnh} hình ảnh
                </p>
                <h3 class="mt-1.5 text-base font-bold leading-snug text-white">{a.ten}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  album.length === 0 && baiViet.length === 0 && !coNoiDung && (
    <section class="border-t border-slate-200 py-14">
      <div class="container-page">
        <div class="mx-auto max-w-2xl rounded-2xl border border-dashed border-brand-200 bg-brand-50/60 p-8 text-center sm:p-10">
          <img src="/logo-goc.svg" alt="" width="261" height="258" class="mx-auto h-20 w-auto opacity-50" />
          <p class="mt-5 text-[0.95rem] leading-relaxed text-slate-600">
            Hình ảnh và tin tức của mảng hoạt động này đang được cập nhật.
          </p>
          <a
            href="/thu-vien"
            class="mt-6 inline-flex min-h-11 items-center rounded-full bg-brand-600 px-6 text-sm font-bold text-white transition hover:bg-brand-700"
          >
            Xem thư viện ảnh
          </a>
        </div>
      </div>
    </section>
  )
}
