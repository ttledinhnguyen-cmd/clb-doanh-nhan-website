---
/**
 * Logo câu lạc bộ.
 *
 * Dùng đúng logo gốc của CLB (chuyển nguyên nét từ file .ai), xếp thành bản
 * nằm ngang bằng scripts/tao-logo.mjs — không gõ lại tên CLB bằng font khác.
 *
 * `variant="tuDong"` dùng trong header: header còn trong suốt trên nền xanh đậm
 * thì hiện bản trắng, header dính lên đầu trang (thẻ cha đặt `data-dinh` và
 * class "group/hdr") thì hiện bản màu gốc.
 */
interface Props {
  variant?: 'mau' | 'trang' | 'tuDong';
  class?: string;
}
const { variant = 'mau', class: className = '' } = Astro.props;

// Tỉ lệ khung của logo-ngang.svg: 399.407 x 79.5.
const RONG = 399;
const CAO = 80;
// Dưới 360px (máy 320px đời cũ) hạ một nấc để nút menu bên cạnh giữ đủ 44px.
const lopCao = 'h-10 w-auto min-[360px]:h-11 sm:h-12';
---

<a
  href="/"
  class:list={['-my-1 flex shrink-0 items-center py-1', className]}
  aria-label="Trang chủ CLB Doanh nhân Khánh Hòa – Sài Gòn"
>
  {
    variant !== 'mau' && (
      <img
        src="/logo-ngang-trang.svg"
        alt=""
        width={RONG}
        height={CAO}
        class:list={[lopCao, variant === 'tuDong' && 'group-data-dinh/hdr:hidden']}
      />
    )
  }
  {
    variant !== 'trang' && (
      <img
        src="/logo-ngang.svg"
        alt=""
        width={RONG}
        height={CAO}
        class:list={[lopCao, variant === 'tuDong' && 'hidden group-data-dinh/hdr:block']}
      />
    )
  }
</a>
