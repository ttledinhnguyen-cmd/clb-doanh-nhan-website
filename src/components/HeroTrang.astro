---
/** Dải đầu trang nền xanh đậm — dùng chung cho mọi trang phụ. */
interface Props {
  nhan?: string;
  tieuDe: string;
  moTa?: string;
  duongDan?: { ten: string; href?: string }[];
}
const { nhan, tieuDe, moTa, duongDan = [] } = Astro.props;
---

<section class="surface-deep relative isolate overflow-hidden">
  <img
    src="/logo-mark.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute -right-16 top-10 w-[34rem] max-w-[75%] opacity-[0.07] brightness-0 invert"
  />

  <div class="container-page relative pb-16 pt-32 sm:pt-36 lg:pb-20 lg:pt-44">
    {
      duongDan.length > 0 && (
        <nav aria-label="Đường dẫn" class="mb-6">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-medium text-brand-200">
            <li>
              <a href="/" class="-my-1.5 inline-block py-1.5 transition hover:text-white">
                Trang chủ
              </a>
            </li>
            {duongDan.map((d) => (
              <>
                <li aria-hidden="true" class="text-brand-400">
                  /
                </li>
                <li>
                  {d.href ? (
                    <a href={d.href} class="-my-1.5 inline-block py-1.5 transition hover:text-white">
                      {d.ten}
                    </a>
                  ) : (
                    <span class="text-white">{d.ten}</span>
                  )}
                </li>
              </>
            ))}
          </ol>
        </nav>
      )
    }

    {
      nhan && (
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-accent-400">{nhan}</p>
      )
    }
    <h1 class="mt-3 max-w-4xl text-(length:--text-h1) font-extrabold leading-[1.1] text-white">
      {tieuDe}
    </h1>
    {
      moTa && (
        <p class="mt-6 max-w-2xl text-(length:--text-lead) leading-relaxed text-brand-100">{moTa}</p>
      )
    }
    <slot />
  </div>
</section>
