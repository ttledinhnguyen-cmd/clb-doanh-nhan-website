---
/** Thẻ chân dung dọc 3:4 – dùng chung cho trang Cơ cấu tổ chức và Hội viên. */
interface Props {
  slug: string;
  hoTen: string;
  xungHo?: string;
  anh: string;
  anhNho?: string;
  vaiTro?: string;
  chucDanh?: string;
  doanhNghiep?: string;
  nganhNghe?: string;
  uuTien?: boolean;
}
const {
  slug,
  hoTen,
  xungHo,
  anh,
  anhNho,
  vaiTro,
  chucDanh,
  doanhNghiep,
  nganhNghe,
  uuTien = false,
} = Astro.props;
const phu = [chucDanh, doanhNghiep].filter(Boolean).join(' · ');
---

<a
  href={`/hoi-vien/${slug}`}
  class="group reveal relative flex flex-col overflow-hidden rounded-2xl bg-slate-100 shadow-sm ring-1 ring-slate-900/5 transition duration-500 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-brand-900/20"
>
  <div class="relative aspect-3/4 overflow-hidden">
    <img
      src={anh}
      srcset={anhNho ? `${anhNho} 600w, ${anh} 1200w` : undefined}
      sizes={anhNho ? '(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 90vw' : undefined}
      alt={`Chân dung ${xungHo ? xungHo + ' ' : ''}${hoTen}`}
      width="1200"
      height="1600"
      loading={uuTien ? 'eager' : 'lazy'}
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-brand-950 via-brand-950/55 to-transparent opacity-90 transition-opacity duration-500 group-hover:opacity-100"
    >
    </div>

    {
      vaiTro && (
        <span class="absolute left-4 top-4 rounded-full bg-accent-500/95 px-3 py-1.5 text-[0.75rem] font-bold uppercase tracking-wide text-white shadow-lg backdrop-blur">
          {vaiTro}
        </span>
      )
    }

    <div class="absolute inset-x-0 bottom-0 p-5">
      <h3 class="text-lg font-bold leading-tight text-white">{hoTen}</h3>
      {phu && <p class="mt-1.5 line-clamp-2 text-[0.82rem] leading-snug text-brand-100/95">{phu}</p>}
      {
        nganhNghe && (
          <p class="mt-3 inline-flex rounded-md bg-white/15 px-2.5 py-1 text-[0.75rem] font-semibold uppercase tracking-wide text-white ring-1 ring-inset ring-white/20 backdrop-blur-sm">
            {nganhNghe}
          </p>
        )
      }
    </div>
  </div>
</a>
