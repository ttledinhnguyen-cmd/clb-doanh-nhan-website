---
/**
 * Thẻ chân dung hội viên.
 *
 * Ảnh chân dung đã tách nền trắng nên phần chữ để hẳn xuống dưới ảnh, không
 * phủ gradient tối lên ảnh như trước — phủ tối lên nền trắng làm nửa dưới ảnh
 * xám đục và nuốt mất chân người.
 */
interface Props {
  slug: string;
  hoTen: string;
  xungHo?: string;
  anh: string;
  anhNho?: string;
  vaiTro?: string;
  chucDanh?: string;
  doanhNghiep?: string;
  nganhNghe?: string;
  uuTien?: boolean;
}
const {
  slug,
  hoTen,
  xungHo,
  anh,
  anhNho,
  vaiTro,
  chucDanh,
  doanhNghiep,
  nganhNghe,
  uuTien = false,
} = Astro.props;
const phu = [chucDanh, doanhNghiep].filter(Boolean).join(' · ');
---

<a
  href={`/hoi-vien/${slug}`}
  class="group reveal flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-900/5 transition duration-500 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-brand-900/15"
>
  <div class="relative aspect-3/4 overflow-hidden bg-slate-50">
    <img
      src={anh}
      srcset={anhNho ? `${anhNho} 600w, ${anh} 1200w` : undefined}
      sizes={anhNho ? '(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 90vw' : undefined}
      alt={`Chân dung ${xungHo ? xungHo + ' ' : ''}${hoTen}`}
      width="1200"
      height="1600"
      loading={uuTien ? 'eager' : 'lazy'}
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
    />

    {
      vaiTro && (
        <span class="absolute left-4 top-4 rounded-full bg-accent-500 px-3 py-1.5 text-[0.75rem] font-bold uppercase tracking-wide text-white shadow-md shadow-accent-900/25">
          {vaiTro}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col border-t border-slate-100 p-5">
    <h3 class="text-lg font-bold leading-tight text-brand-900 transition-colors group-hover:text-brand-600">
      {hoTen}
    </h3>
    {phu && <p class="mt-1.5 line-clamp-2 text-[0.85rem] leading-snug text-slate-500">{phu}</p>}
    {
      nganhNghe && (
        <p class="mt-auto pt-4">
          <span class="inline-flex rounded-md bg-brand-50 px-2.5 py-1 text-[0.75rem] font-semibold uppercase tracking-wide text-brand-700">
            {nganhNghe}
          </span>
        </p>
      )
    }
  </div>
</a>
