---
import Logo from './Logo.astro';

/**
 * Menu bám theo các mục in đậm trong tài liệu của CLB.
 *
 * Chín mục xếp ngang hết trên máy tính sẽ chật, nên ba mục con của Giới thiệu và
 * ba mảng Hoạt động được gom vào menu xổ xuống. Bấm vào mục cha vẫn ra trang
 * tổng hợp chứ không phải bấm hụt.
 */
const menu = [
  {
    ten: 'Giới thiệu',
    href: '/gioi-thieu',
    con: [
      { ten: 'Lịch sử hình thành', href: '/gioi-thieu#lich-su' },
      { ten: 'Tiêu chí hoạt động', href: '/gioi-thieu#tieu-chi' },
      { ten: 'Thành tựu nổi bật', href: '/gioi-thieu#thanh-tuu' },
    ],
  },
  { ten: 'Cơ cấu tổ chức', href: '/co-cau-to-chuc' },
  { ten: 'Hội viên', href: '/hoi-vien' },
  {
    ten: 'Hoạt động',
    href: '/hoat-dong',
    con: [
      { ten: 'Công tác xã hội', href: '/hoat-dong/cong-tac-xa-hoi' },
      { ten: 'Phát triển thành viên', href: '/hoat-dong/phat-trien-thanh-vien' },
      { ten: 'Văn hoá – Thể thao', href: '/hoat-dong/van-hoa-the-thao' },
      { ten: 'Sự kiện câu lạc bộ', href: '/su-kien' },
    ],
  },
  { ten: 'Tin tức', href: '/tin-tuc' },
  { ten: 'Thư viện', href: '/thu-vien' },
  { ten: 'Liên hệ', href: '/lien-he' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const dangO = (href: string) => {
  const goc = href.split('#')[0];
  return path === goc || path.startsWith(goc + '/');
};

const lopLink =
  'group/nav relative rounded-lg px-3 py-2 text-[0.88rem] font-semibold text-white/85 transition-colors hover:text-white aria-[current=page]:text-white group-data-dinh/hdr:text-slate-600 group-data-dinh/hdr:hover:text-brand-700 group-data-dinh/hdr:aria-[current=page]:text-brand-700 xl:px-3.5 xl:text-[0.92rem]';
---

<header
  id="site-header"
  class="group/hdr fixed inset-x-0 top-0 z-50 transition-[background-color,box-shadow,backdrop-filter] duration-300 data-dinh:bg-white/92 data-dinh:shadow-[0_1px_0_0_rgb(0_0_0/0.06),0_10px_30px_-18px_rgb(0_42_71/0.35)] data-dinh:backdrop-blur-xl"
>
  <div class="container-page flex h-16 items-center justify-between gap-3 sm:h-20">
    <Logo variant="tuDong" />

    <nav class="hidden items-center xl:flex" aria-label="Điều hướng chính">
      {
        menu.map((m) =>
          m.con ? (
            <div class="group/xo relative">
              <a href={m.href} aria-current={dangO(m.href) ? 'page' : undefined} class={`${lopLink} inline-flex items-center gap-1`}>
                {m.ten}
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 opacity-60 transition-transform duration-300 group-hover/xo:rotate-180" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 9l6 6 6-6" />
                </svg>
                <span
                  aria-hidden="true"
                  class="absolute inset-x-3 bottom-0.5 h-0.5 origin-left scale-x-0 rounded-full bg-accent-500 transition-transform duration-300 group-hover/nav:scale-x-100 group-aria-[current=page]/nav:scale-x-100"
                />
              </a>

              <div class="invisible absolute left-0 top-full pt-2 opacity-0 transition-[opacity,visibility] duration-200 group-hover/xo:visible group-hover/xo:opacity-100 group-focus-within/xo:visible group-focus-within/xo:opacity-100">
                <ul class="min-w-56 overflow-hidden rounded-xl bg-white py-2 shadow-xl shadow-brand-950/15 ring-1 ring-slate-900/10">
                  {m.con.map((c) => (
                    <li>
                      <a
                        href={c.href}
                        class="block px-4 py-2.5 text-[0.88rem] font-semibold text-slate-600 transition hover:bg-brand-50 hover:text-brand-700"
                      >
                        {c.ten}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a href={m.href} aria-current={dangO(m.href) ? 'page' : undefined} class={lopLink}>
              {m.ten}
              <span
                aria-hidden="true"
                class="absolute inset-x-3 bottom-0.5 h-0.5 origin-left scale-x-0 rounded-full bg-accent-500 transition-transform duration-300 group-hover/nav:scale-x-100 group-aria-[current=page]/nav:scale-x-100"
              />
            </a>
          ),
        )
      }
      <a
        href="/dang-ky"
        class="ml-2 shrink-0 rounded-full bg-white/12 px-4 py-2.5 text-[0.88rem] font-semibold text-white ring-1 ring-inset ring-white/25 backdrop-blur transition hover:-translate-y-0.5 hover:bg-white/20 group-data-dinh/hdr:bg-brand-600 group-data-dinh/hdr:text-white group-data-dinh/hdr:shadow-lg group-data-dinh/hdr:shadow-brand-600/25 group-data-dinh/hdr:ring-transparent group-data-dinh/hdr:hover:bg-brand-700 xl:ml-3 xl:px-5 xl:text-[0.92rem]"
        >Gia nhập CLB</a
      >
    </nav>

    <button
      type="button"
      id="nut-menu"
      class="relative z-10 grid h-11 w-11 shrink-0 place-items-center rounded-xl text-white transition hover:bg-white/10 group-data-dinh/hdr:text-brand-800 group-data-dinh/hdr:hover:bg-brand-50 xl:hidden"
      aria-controls="menu-mobile"
      aria-expanded="false"
    >
      <span class="sr-only">Mở menu</span>
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16" data-icon-mo></path>
        <path d="M6 6l12 12M18 6L6 18" class="hidden" data-icon-dong></path>
      </svg>
    </button>
  </div>

  {/* Điện thoại: danh sách dọc, mục con thụt vào cho dễ nhìn */}
  <div
    id="menu-mobile"
    class="grid grid-rows-[0fr] overflow-hidden border-t border-transparent bg-white transition-[grid-template-rows,border-color] duration-300 xl:hidden"
  >
    <nav class="min-h-0 overflow-y-auto" aria-label="Điều hướng di động">
      <ul class="container-page flex max-h-[75vh] flex-col gap-0.5 py-4">
        {
          menu.map((m) => (
            <li>
              <a
                href={m.href}
                aria-current={dangO(m.href) ? 'page' : undefined}
                class="block rounded-xl px-4 py-3 text-base font-semibold text-slate-700 transition hover:bg-brand-50 hover:text-brand-700 aria-[current=page]:bg-brand-50 aria-[current=page]:text-brand-700"
              >
                {m.ten}
              </a>
              {m.con && (
                <ul class="mb-1 ml-4 border-l-2 border-slate-100 pl-3">
                  {m.con.map((c) => (
                    <li>
                      <a
                        href={c.href}
                        class="block rounded-lg px-4 py-2.5 text-[0.92rem] text-slate-500 transition hover:bg-brand-50 hover:text-brand-700"
                      >
                        {c.ten}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
        <li class="pt-2">
          <a
            href="/dang-ky"
            class="block rounded-xl bg-brand-600 px-4 py-3.5 text-center text-base font-semibold text-white"
            >Gia nhập CLB</a
          >
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const nut = document.getElementById('nut-menu')!;
  const menu = document.getElementById('menu-mobile')!;
  const iconMo = nut.querySelector('[data-icon-mo]')!;
  const iconDong = nut.querySelector('[data-icon-dong]')!;

  const menuDangMo = () => nut.getAttribute('aria-expanded') === 'true';

  const capNhatNen = () => {
    if (window.scrollY > 12 || menuDangMo()) header.dataset.dinh = '';
    else delete header.dataset.dinh;
  };
  capNhatNen();
  addEventListener('scroll', capNhatNen, { passive: true });

  nut.addEventListener('click', () => {
    const mo = !menuDangMo();
    nut.setAttribute('aria-expanded', String(mo));
    menu.classList.toggle('grid-rows-[1fr]', mo);
    menu.classList.toggle('border-slate-200', mo);
    iconMo.classList.toggle('hidden', mo);
    iconDong.classList.toggle('hidden', !mo);
    capNhatNen();
  });
</script>
